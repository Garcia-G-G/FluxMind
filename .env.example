# Database
DATABASE_URL=postgresql://fluxmind:fluxmind@localhost:5433/fluxmind

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Better Auth)
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:4500

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Provider (OpenAI — used by chat, studio generators, narration scripts)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs (TTS / Podcasts / Studio narration)
# Get a key at https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=
# Optional voice overrides (ElevenLabs voice IDs — leave blank for defaults)
# Narrator used by Studio narration for infographics/slides (default: Rachel)
ELEVENLABS_NARRATOR_VOICE=
# Two-host podcast voices (defaults: Rachel + Adam)
ELEVENLABS_VOICE_ALEX=
ELEVENLABS_VOICE_JORDAN=

# Fal.ai (FLUX image generation for infographics/slides, video pipeline)
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Cloudflare R2 (Object Storage for generated images/audio/video)
# Create a bucket + API token at https://dash.cloudflare.com/?to=/:account/r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fluxmind
# Public URL of the R2 bucket (custom domain or r2.dev URL)
R2_PUBLIC_URL=

# Stripe (Payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Search (Deep Research)
SERPER_API_KEY=

# Processing
# Set to "true" to skip real embedding API calls and use mock vectors
MOCK_EMBEDDINGS=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:4500
